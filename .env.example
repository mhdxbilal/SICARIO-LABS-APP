# SICARIO LABS - Offline-First Media Player
# Environment Configuration

# ============================================
# OFFLINE-FIRST APPLICATION
# NO INTERNET CONNECTION REQUIRED
# ============================================

# Optional: Gemini API Key (for offline processing only)
# Leave empty for full offline mode
GEMINI_API_KEY=

# Application Mode
APP_MODE=offline
OFFLINE_ONLY=true
ANALYTICS_ENABLED=false
TRACKING_ENABLED=false
ADS_ENABLED=false

# Cache Configuration
CACHE_ENABLED=true
CACHE_SIZE_MB=500
CACHE_EXPIRY_DAYS=30

# Media Scanning
MEDIA_SCAN_ENABLED=true
MEDIA_SCAN_INTERVAL=24

# Security
NO_INTERNET_VERIFICATION=true
LOCAL_STORAGE_ONLY=true
