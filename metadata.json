{
  "app": {
    "name": "SICARIO LABS - Media Player",
    "version": "2.0.0",
    "versionCode": 2,
    "package": "com.siciario.labs.mediaplayer",
    "description": "Advanced offline-first Android media player with AI-powered organization",
    "offlineFirst": true,
    "requiresInternet": false
  },
  "features": {
    "offlineMode": {
      "enabled": true,
      "description": "Strictly offline operation - no internet required"
    },
    "mediaPlayback": {
      "enabled": true,
      "formats": {
        "audio": ["mp3", "wav", "flac", "aac", "ogg", "m4a", "wma"],
        "video": ["mp4", "mkv", "webm", "avi", "3gp", "flv"]
      }
    },
    "localCache": {
      "enabled": true,
      "maxSizeMB": 500,
      "expiryDays": 30
    },
    "ai": {
      "enabled": true,
      "type": "on-device",
      "description": "Local AI processing, no cloud calls"
    },
    "analytics": {
      "enabled": false,
      "description": "No tracking or analytics"
    },
    "ads": {
      "enabled": false
    }
  },
  "permissions": {
    "required": [
      "READ_EXTERNAL_STORAGE",
      "READ_MEDIA_AUDIO",
      "READ_MEDIA_VIDEO",
      "READ_MEDIA_IMAGES"
    ],
    "optional": []
  },
  "minimum": {
    "sdk": 24,
    "sdkName": "Android 7.0",
    "ram": "2GB",
    "storage": "100MB"
  },
  "target": {
    "sdk": 36,
    "sdkName": "Android 15"
  },
  "tech": {
    "language": "Kotlin",
    "ui": "Jetpack Compose",
    "database": "Room",
    "media": "Media3/ExoPlayer",
    "json": "Moshi",
    "imageLoading": "Coil",
    "async": "Coroutines"
  },
  "privacy": {
    "noInternetRequired": true,
    "noTracking": true,
    "noAds": true,
    "dataStorageLocation": "local"
  }
}
